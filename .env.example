# ====================================================================
# PRIME BITES - BACKEND ENVIRONMENT VARIABLES TEMPLATE
# ====================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
# DO NOT COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL!
# ====================================================================

# Active Profile: 'dev' for local MySQL, 'prod' for TiDB Cloud / Render
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --------------------------------------------------------------------
# Local Development Database (Used when SPRING_PROFILES_ACTIVE=dev)
# --------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=food_delivery
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_local_db_password

# --------------------------------------------------------------------
# Security / JWT Configuration
# --------------------------------------------------------------------
# A cryptographically secure 512-bit (64-byte) Base64 string for HS512:
JWT_SECRET=your_base64_encoded_512_bit_jwt_secret_here
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# --------------------------------------------------------------------
# Production Database (Set directly in Render Dashboard when SPRING_PROFILES_ACTIVE=prod)
# --------------------------------------------------------------------
# SPRING_DATASOURCE_URL=jdbc:mysql://<TIDB_HOST>:4000/food_delivery?sslMode=VERIFY_IDENTITY
# SPRING_DATASOURCE_USERNAME=<TIDB_CLUSTER_PREFIX>.<USER>
# SPRING_DATASOURCE_PASSWORD=<TIDB_PASSWORD>
